{
  "name": "order-store-backend",
  "version": "1.0.0",
  "description": "Backend API service for OrderStore",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:integration": "node --test test/performance-harness.test.js test/performance-index-migration.test.js",
    "test:postgres": "node --test test/postgres-adapter.integration.test.js test/postgres-schema.integration.test.js test/postgres-seed.integration.test.js test/postgres-auth.integration.test.js test/postgres-public-read.integration.test.js test/postgres-test-guard.test.js test/postgres-schema-contract.test.js",
    "db:pg:migrate": "node database/postgres/migrate.js",
    "db:pg:migrate:test": "node database/postgres/migrate.js",
    "db:pg:seed": "node database/postgres/seed-demo.js",
    "db:pg:otp:cleanup": "node database/postgres/cleanup-otp.js",
    "perf:seed": "node perf/seed-performance-data.js",
    "perf:bench": "node perf/run-query-benchmarks.js",
    "db:init": "node init-db.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@payos/node": "^2.0.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "msnodesqlv8": "^5.2.3",
    "mssql": "^11.0.1",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
