NODE_ENV=development
PORT=5000

# SQL Server Configuration (Legacy/Transition)
DB_SERVER=localhost\\SQLEXPRESS
DB_NAME=teaplus_db
# Để true nếu dùng Windows Authentication (không cần user/password)
# Để false nếu dùng SQL Server Authentication (cần DB_USER + DB_PASSWORD)
DB_TRUSTED=true
DB_USER=sa
DB_PASSWORD=

# Security & Reverse Proxy
JWT_SECRET=thay-bang-chuoi-bi-mat-dai-32-ky-tu
# Danh sách origin frontend được phép gọi API (phân tách bằng dấu phẩy)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080
# Reverse proxy hop count for Render (mặc định 1)
TRUST_PROXY=1
# Swagger API docs toggle (mặc định false ở production)
ENABLE_API_DOCS=false

# SMS Provider for Customer Phone OTP
PHONE_OTP_ENABLED=false
SMS_PROVIDER=generic_http
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# PayOS Payment Gateway (Tùy chọn - Nếu dùng phải điền đủ cả 3 key)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:8080/theo-doi-don
PAYOS_CANCEL_URL=http://localhost:8080/thanh-toan
PAYOS_PAYMENT_TIMEOUT_MINUTES=15

# Google Auth (Tùy chọn cho Login Google Khách Hàng)
GOOGLE_CLIENT_ID=
