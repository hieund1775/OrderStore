NODE_ENV=development
PORT=5000

# ═══════════════════════════════════════════════════════════════════
# PostgreSQL / Supabase Database Configuration (Primary Production Runtime)
# ═══════════════════════════════════════════════════════════════════
DB_DIALECT=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teaplus_dev
# On Supabase / Render: use transaction pooler URL with sslmode=require
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require

# Dedicated Test Database Target (Used for integration test runs)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teaplus_test

# Connection Pool Settings
PG_POOL_MAX=10
PG_IDLE_TIMEOUT=30000
PG_CONNECT_TIMEOUT=5000
PGSSLMODE=disable
# PGSSLMODE=require (for Supabase / Render production)

# ═══════════════════════════════════════════════════════════════════
# Security, Reverse Proxy & CORS
# ═══════════════════════════════════════════════════════════════════
JWT_SECRET=thay-bang-chuoi-bi-mat-ngau-nhien-it-nhat-32-ky-tu
JWT_EXPIRES_IN=7d
# Danh sách origin frontend được phép gọi API (phân tách bằng dấu phẩy)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080
# Reverse proxy trust setting for Render (true or hop count 1)
TRUST_PROXY=true
# Swagger API docs toggle (mặc định false ở production)
ENABLE_API_DOCS=false

# ═══════════════════════════════════════════════════════════════════
# SMS Provider for Customer Phone OTP
# ═══════════════════════════════════════════════════════════════════
PHONE_OTP_ENABLED=false
SMS_PROVIDER=generic_http
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ═══════════════════════════════════════════════════════════════════
# PayOS Payment Gateway
# ═══════════════════════════════════════════════════════════════════
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:8080/theo-doi-don
PAYOS_CANCEL_URL=http://localhost:8080/thanh-toan
PAYOS_PAYMENT_TIMEOUT_MINUTES=15
PAYOS_EXPIRE_BATCH_SIZE=50

# ═══════════════════════════════════════════════════════════════════
# Google Auth (Tùy chọn cho Login Google Khách Hàng)
# ═══════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=
