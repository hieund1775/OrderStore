# Backend API URL (Production Render backend connected to Supabase Cloud)
EXPO_PUBLIC_API_URL=https://teaplus-order-backend.onrender.com

# For local development with backend running on host machine:
# Android Emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# iOS Simulator / Web: EXPO_PUBLIC_API_URL=http://localhost:5000
# Physical device on Wi-Fi: EXPO_PUBLIC_API_URL=http://<YOUR_LAN_IP>:5000
