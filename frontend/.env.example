# API URL Backend Express (Ví dụ: http://localhost:5000 hoặc URL backend live)
VITE_API_URL=http://localhost:5000

# Bật chế độ Standalone Vercel (true/false).
# Nếu = true, Frontend sẽ chạy 100% Client-side Storage Mode mà không cần Deploy Backend Express.
# Nếu không đặt, hệ thống sẽ tự động fallback sang Standalone Mode nếu Backend không phản hồi.
VITE_STANDALONE=true
